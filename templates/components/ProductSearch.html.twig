<div {{ attributes }}>
    <div class="mb-4">
        <div class="input-group input-group-lg">
            <span class="input-group-text bg-primary text-white">
                <i class="bi bi-search"></i>
            </span>
            <input
                type="text"
                class="form-control form-control-lg"
                placeholder="{{ 'search.placeholder'|trans }}"
                value="{{ query }}"
                data-model="debounce(300)|query"
            >
        </div>
        {% if query|length > 0 and query|length < 2 %}
            <small class="text-muted">{{ 'search.minChars'|trans }}</small>
        {% endif %}
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        {% set products = this.getProducts() %}

        {% if query|length >= 2 %}
            {% if products|length > 0 %}
                {% for product in products %}
                    <div class="col">
                        <a href="{{ path('product.show', {'id': product.id, '_locale': app.request.locale}) }}" class="text-decoration-none">
                            <div class="card h-100 shadow-sm border-0 product-card">
                                <div class="position-relative overflow-hidden" style="height: 250px;">
                                    {% if product.getImage|length > 0 %}
                                        <img src="{{ product.getImage[0].url }}" class="card-img-top w-100 h-100 object-fit-cover" alt="{{ product.name }}" style="transition: transform 0.3s ease;">
                                    {% else %}
                                        <div class="w-100 h-100 bg-secondary d-flex align-items-center justify-content-center">
                                            <i class="bi bi-image text-white" style="font-size: 3rem;"></i>
                                        </div>
                                    {% endif %}

                                    <div class="position-absolute top-0 end-0 m-2">
                                        {% if product.status.value == 'OUT_OF_STOCK' %}
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle"></i>
                                                {{ 'product.status.outOfStock'|trans }}
                                            </span>
                                        {% elseif product.status.value == 'PREORDER' %}
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-clock"></i>
                                                {{ 'product.status.preorder'|trans }}
                                            </span>
                                        {% else %}
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i>
                                                {{ 'product.status.available'|trans }}
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>

                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title text-dark fw-bold mb-2">{{ product.name }}</h5>

                                    {% if product.description %}
                                        <p class="card-text text-muted small mb-3" style="overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                            {{ product.description }}
                                        </p>
                                    {% endif %}

                                    <div class="mt-auto">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="h4 mb-0 text-primary fw-bold">{{ product.price|number_format(2, ',', ' ') }} €</span>
                                            {% if product.stock > 0 %}
                                                <span class="badge {{ product.stock <= 5 ? 'bg-warning text-dark' : 'bg-info' }}">
                                                    {{ product.stock }} {{ 'product.inStock'|trans }}
                                                </span>
                                            {% else %}
                                                <span class="badge bg-secondary">{{ 'product.unavailable'|trans }}</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            {% else %}
                <div class="col-12">
                    <div class="alert alert-warning text-center" role="alert">
                        <i class="bi bi-search"></i>
                        {{ 'search.noResults'|trans }}
                    </div>
                </div>
            {% endif %}
        {% elseif query|length == 0 %}
            <div class="col-12">
                <div class="alert alert-info text-center" role="alert">
                    <i class="bi bi-info-circle"></i>
                    {{ 'search.enterQuery'|trans }}
                </div>
            </div>
        {% endif %}
    </div>
</div>

<style>
    .product-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.15) !important;
    }

    .product-card:hover img {
        transform: scale(1.05);
    }
</style>
