{% extends 'base.html.twig' %}

{% block title %}{{ 'recap.pageTitle'|trans }}
{% endblock %}

{% block body %}
	<div class="container my-4">
		<nav aria-label="breadcrumb" class="mb-3">
			<ol class="breadcrumb">
				<li class="breadcrumb-item">
					<a href="{{ path('home', {'_locale': app.request.locale}) }}">{{ 'navbar.home'|trans }}</a>
				</li>
				<li class="breadcrumb-item">
					<a href="{{ path('cart', {'_locale': app.request.locale}) }}">{{ 'cart.title'|trans }}</a>
				</li>
				<li class="breadcrumb-item">
					<a href="{{ path('address', {'_locale': app.request.locale}) }}">{{ 'address.breadcrumb'|trans }}</a>
				</li>
				<li class="breadcrumb-item active">{{ 'recap.breadcrumb'|trans }}</li>
			</ol>
		</nav>

		<h2 class="mb-4">{{ 'recap.title'|trans }}</h2>

		{% for message in app.flashes('success') %}
			<div class="alert alert-dismissible alert-success">
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
				{{ message }}
			</div>
		{% endfor %}

		<div class="row">
			<div class="col-md-8">
				{# recap #}
				<div class="card mb-3">
					<div class="card-header">
						<h5 class="mb-0">{{ 'recap.orderedItems.title'|trans }}</h5>
					</div>
					<div class="card-body">
						<table class="table mb-0">
							<thead>
								<tr>
									<th>{{ 'recap.orderedItems.product'|trans }}</th>
									<th class="text-center">{{ 'recap.orderedItems.unitPrice'|trans }}</th>
									<th class="text-center">{{ 'recap.orderedItems.quantity'|trans }}</th>
									<th class="text-center">{{ 'recap.orderedItems.subtotal'|trans }}</th>
								</tr>
							</thead>
							<tbody>
								{% for item in cart.items %}
									<tr>
										<td>{{ item.product.name }}</td>
										<td class="text-center">{{ item.product.price|number_format(2, ',', ' ') }} €</td>
										<td class="text-center">{{ item.quantity }}</td>
										<td class="text-center">{{ item.getTotalPrice()|number_format(2, ',', ' ') }} €</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>

				{# Infos cli #}
				<div class="card mb-3">
					<div class="card-header">
						<h5 class="mb-0">{{ 'recap.clientInfo.title'|trans }}</h5>
					</div>
					<div class="card-body">
						<div class="row">
							<div class="col-md-6 mb-3">
								<p class="mb-1">
									<strong>{{ 'recap.clientInfo.lastName'|trans }}
										:</strong>
								</p>
								<p>{{ user.lastName }}</p>
							</div>
							<div class="col-md-6 mb-3">
								<p class="mb-1">
									<strong>{{ 'recap.clientInfo.firstName'|trans }}
										:</strong>
								</p>
								<p>{{ user.firstName }}</p>
							</div>
						</div>
						<div class="row">
							<div class="col-md-12 mb-3">
								<p class="mb-1">
									<strong>{{ 'recap.clientInfo.email'|trans }}
										:</strong>
								</p>
								<p>{{ user.email }}</p>
							</div>
						</div>
						<div class="row">
							<div class="col-md-12">
								<p class="mb-1">
									<strong>{{ 'recap.clientInfo.shippingAddress'|trans }}
										:</strong>
								</p>
								<p class="mb-1">{{ address.street }}</p>
								<p class="mb-1">{{ address.postalCode }}
									{{ address.city }}</p>
								<p class="mb-0">{{ address.country }}</p>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="col-md-4">
				<div class="card">
					<div class="card-body">
						<h5>{{ 'recap.summary.title'|trans }}</h5>
						<hr>
						<div class="d-flex justify-content-between mb-2">
							<span>{{ 'recap.summary.items'|trans }}
								({{ cart.totalItems }})</span>
							<span>{{ cart.totalPrice|number_format(2, ',', ' ') }} €</span>
						</div>
						<div class="d-flex justify-content-between mb-2">
							<span>{{ 'recap.summary.shipping'|trans }}</span>
							<span class="text-success">{{ 'recap.summary.shippingFree'|trans }}</span>
						</div>
						<hr>
						<div class="d-flex justify-content-between mb-3">
							<strong>{{ 'recap.summary.total'|trans }}</strong>
							<strong class="text-primary">{{ cart.totalPrice|number_format(2, ',', ' ') }} €</strong>
						</div>

						<div class="d-grid gap-2">
							<button class="btn btn-success btn-lg">
								{{ 'recap.buttons.pay'|trans }}
							</button>
							<a href="{{ path('address', {'_locale': app.request.locale}) }}" class="btn btn-secondary">
								{{ 'recap.buttons.modifyAddress'|trans }}
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
