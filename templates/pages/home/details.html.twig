{% extends "base.html.twig" %}

{% block title %}{{ product.name }} - {{ 'product.pageTitle'|trans }}
{% endblock %}

{% block body %}
	{# Navigation #}
	<div class="container-fluid">
		<nav aria-label="breadcrumb" class="mb-4">
			<ol class="breadcrumb">
				<li class="breadcrumb-item">
					<a href="{{ path('home') }}">
						<i class="bi bi-house-door"></i>
						{{ 'navbar.home'|trans }}</a>
				</li>
				<li class="breadcrumb-item active" aria-current="page">{{ product.name }}</li>
			</ol>
		</nav>

		<div class="row g-5">
		{# IMAGES #}
			<div class="col-lg-6">
				<div class="card border-0 shadow-sm">
					<div class="card-body p-0">
						{% if product.getImage|length > 0 %}
							<div id="productCarousel" class="carousel slide">
								<div class="carousel-inner">
									{% for image in product.getImage %}
										<div class="carousel-item {{ loop.first ? 'active' : '' }}">
											<img src="{{ image.url }}" class="d-block w-100 rounded" alt="{{ product.name }}" style="max-height: 500px; object-fit: contain; background: #f8f9fa;">
										</div>
									{% endfor %}
								</div>
								{% if product.getImage|length > 1 %}
									<button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
										<span class="carousel-control-prev-icon" aria-hidden="true"></span>
										<span class="visually-hidden">{{ 'product.previous'|trans }}</span>
									</button>
									<button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
										<span class="carousel-control-next-icon" aria-hidden="true"></span>
										<span class="visually-hidden">{{ 'product.next'|trans }}</span>
									</button>
								{% endif %}
							</div>
						{% else %}
							<div class="d-flex align-items-center justify-content-center bg-secondary rounded" style="height: 400px;">
								<i class="bi bi-image text-white" style="font-size: 5rem;"></i>
							</div>
						{% endif %}
					</div>
				</div>
			</div>

			
			{# Details #}
			<div class="col-lg-6">
				<div class="mb-3">
					{% if product.category %}
						<span class="badge bg-secondary mb-2">
							<i class="bi bi-tag"></i>
							{{ product.category.name }}
						</span>
					{% endif %}

					<h1 class="display-5 fw-bold mb-3">{{ product.name }}</h1>

					<div class="mb-3">
						{% if product.status.value == 'OUT_OF_STOCK' %}
							<span class="badge bg-danger fs-6">
								<i class="bi bi-x-circle"></i>
								{{ 'product.status.outOfStock'|trans }}
							</span>
						{% elseif product.status.value == 'PREORDER' %}
							<span class="badge bg-warning text-dark fs-6">
								<i class="bi bi-clock"></i>
								{{ 'product.status.preorder'|trans }}
							</span>
						{% else %}
							<span class="badge bg-success fs-6">
								<i class="bi bi-check-circle"></i>
								{{ 'product.status.available'|trans }}
							</span>
						{% endif %}
					</div>

					<div class="mb-4">
						<h2 class="display-4 text-primary fw-bold mb-0">{{ product.price|number_format(2, ',', ' ') }} €</h2>
					</div>

					{# Stock #}
					<div class="card bg-light border-0 mb-4">
						<div class="card-body">
							<div class="d-flex align-items-center">
								<i class="bi bi-box-seam fs-4 me-3 text-muted"></i>
								<div>
									<p class="mb-0 fw-bold">{{ 'product.stock'|trans }}</p>
									{% if product.stock > 0 %}
										<p class="mb-0">
											<span class="text-success fw-bold">{{ product.stock }}</span>
											{{ 'product.units'|trans }}
											{{ product.stock <= 5 ? '(' ~ ('product.lowStock'|trans) ~ ')' : '' }}
										</p>
									{% else %}
										<p class="mb-0 text-danger fw-bold">{{ 'product.outOfStock'|trans }}</p>
									{% endif %}
								</div>
							</div>
						</div>
					</div>

					{# Panier #}
					<div class="mb-4">
						{% if product.stock > 0 or product.status.value == 'PREORDER' %}
							{% if app.user %}
								<div data-controller="cart"
									 data-cart-product-id-value="{{ product.id }}"
									 data-cart-locale-value="{{ app.request.locale }}">
									<div class="row g-3">
										<div class="col-md-4">
											<label for="quantity" class="form-label fw-bold">{{ 'product.quantity'|trans }}</label>
											<input type="number"
												   class="form-control form-control-lg"
												   id="quantity"
												   name="quantity"
												   value="1"
												   min="1"
												   max="{{ product.stock }}"
												   data-cart-target="quantity"
												   required>
										</div>
										<div class="col-md-8 d-flex align-items-end">
											<button type="button"
													class="btn btn-primary btn-lg w-100"
													data-cart-target="addButton"
													data-action="click->cart#addToCart">
												<i class="bi bi-cart-plus"></i>
												{{ 'product.addToCart'|trans }}
											</button>
										</div>
									</div>
								</div>
							{% else %}
								<a href="{{ path('security.login') }}" class="btn btn-primary btn-lg w-100">
									<i class="bi bi-person"></i>
									{{ 'product.loginToAddToCart'|trans }}
								</a>
							{% endif %}
						{% else %}
							<button class="btn btn-secondary btn-lg w-100" disabled>
								<i class="bi bi-ban"></i>
								{{ 'product.unavailable'|trans }}
							</button>
						{% endif %}
					</div>

					{# ♥/Wish #}
					<div class="d-flex gap-2">
						<button class="btn btn-outline-secondary">
							<i class="bi bi-heart"></i>
							{{ 'product.addToWishlist'|trans }}
						</button>
						<button class="btn btn-outline-secondary">
							<i class="bi bi-share"></i>
							{{ 'product.share'|trans }}
						</button>
					</div>
				</div>
			</div>
		</div>

		{# Description #}
		<div class="row mt-5">
			<div class="col-12">
				<div class="card border-0 shadow-sm">
					<div class="card-body p-4">
						<h3 class="card-title mb-3">
							<i class="bi bi-info-circle"></i>
							{{ 'product.description'|trans }}
						</h3>
						{% if product.description %}
							<p class="card-text lead">{{ product.description }}</p>
						{% else %}
							<p class="text-muted fst-italic">{{ 'product.noDescription'|trans }}</p>
						{% endif %}
					</div>
				</div>
			</div>
		</div>

		{# Details #}
		<div class="row mt-4 mb-5">
			<div class="col-12">
				<div class="card border-0 shadow-sm">
					<div class="card-body p-4">
						<h3 class="card-title mb-4">
							<i class="bi bi-list-ul"></i>
							{{ 'product.details'|trans }}
						</h3>
						<div class="row">
							<div class="col-md-6">
								<dl class="row">
									<dt class="col-sm-5">{{ 'product.reference'|trans }}</dt>
									<dd class="col-sm-7">#{{ product.id }}</dd>

									<dt class="col-sm-5">{{ 'product.category'|trans }}</dt>
									<dd class="col-sm-7">
										{% if product.category %}
											{{ product.category.name }}
										{% else %}
											<span class="text-muted fst-italic">{{ 'product.noCategory'|trans }}</span>
										{% endif %}
									</dd>

									<dt class="col-sm-5">{{ 'product.statusTitle'|trans }}</dt>
									<dd class="col-sm-7">
										{% if product.status.value == 'OUT_OF_STOCK' %}
											{{ 'product.status.outOfStock'|trans }}
										{% elseif product.status.value == 'PREORDER' %}
											{{ 'product.status.preorder'|trans }}
										{% else %}
											{{ 'product.status.available'|trans }}
										{% endif %}
									</dd>
								</dl>
							</div>
							<div class="col-md-6">
								<dl class="row">
									<dt class="col-sm-5">{{ 'product.price'|trans }}</dt>
									<dd class="col-sm-7 fw-bold text-primary">{{ product.price|number_format(2, ',', ' ') }} €</dd>

									<dt class="col-sm-5">{{ 'product.stock'|trans }}</dt>
									<dd class="col-sm-7">{{ product.stock }}
										{{ 'product.units'|trans }}</dd>

									<dt class="col-sm-5">{{ 'product.addedOn'|trans }}</dt>
									<dd class="col-sm-7">{{ product.createdAt|date('d/m/Y') }}</dd>
								</dl>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="text-center mb-5">
			<a href="{{ path('home') }}" class="btn btn-outline-primary btn-lg">
				<i class="bi bi-arrow-left"></i>
				{{ 'product.backToProducts'|trans }}
			</a>
		</div>
	</div>

	<style>
		.carousel-control-prev-icon,
		.carousel-control-next-icon {
			background-color: rgba(0, 0, 0, 0.5);
			border-radius: 50%;
			padding: 20px;
		}
	</style>
{% endblock %}
