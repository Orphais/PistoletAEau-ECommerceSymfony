{% extends "base.html.twig" %}

{% block title %}
    {{ 'search.pageTitle'|trans }}
{% endblock %}

{% block body %}
    <div data-turbo="false">
    <div class="container-fluid px-0 mb-5">
        <div class="bg-primary text-white text-center py-5 px-4 rounded-3 shadow-sm">
            <h1 class="display-4 fw-bold mb-3">
                <i class="bi bi-search"></i>
                {{ 'search.title'|trans }}
            </h1>
            <p class="lead mb-0">{{ 'search.description'|trans }}</p>
        </div>
    </div>

    <div class="container-fluid px-3">
        {{ component('ProductSearch') }}
    </div>
    </div>
{% endblock %}
