{% extends "base.html.twig" %}

{% block title %}
    {{ 'search.pageTitle'|trans }}
{% endblock %}

{% block body %}
    <div data-turbo="false">
    <div class="container-fluid px-0 mb-5">
        <div class="bg-primary text-white text-center py-5 px-4 rounded-3 shadow-sm">
            <h1 class="display-4 fw-bold mb-3">
                <i class="bi bi-search"></i>
                {{ 'search.title'|trans }}
            </h1>
            <p class="lead mb-0">{{ 'search.description'|trans }}</p>
        </div>
    </div>

    <div class="container-fluid px-3">
        <div data-controller="product-search" data-product-search-locale-value="{{ app.request.locale }}">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control"
                               placeholder="{{ 'search.placeholder'|trans }}"
                               data-product-search-target="searchInput"
                               data-action="input->product-search#search keyup->product-search#handleKeyup"
                               autocomplete="off">
                        <button class="btn btn-outline-secondary" type="button" data-action="click->product-search#clear">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    <div class="position-relative">
                        <div class="list-group mt-2 position-absolute w-100"
                             style="z-index: 1000; max-height: 400px; overflow-y: auto; display: none;"
                             data-product-search-target="autocompleteResults">
                        </div>
                    </div>
                </div>
            </div>

            <div data-product-search-target="loadingIndicator" class="text-center my-4" style="display: none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">{{ 'search.loading'|trans }}</span>
                </div>
            </div>

            <div data-product-search-target="searchResults">
                <div class="text-center text-muted py-5">
                    <i class="bi bi-search" style="font-size: 3rem;"></i>
                    <p class="mt-3">{{ 'search.startTyping'|trans }}</p>
                </div>
            </div>

            <div data-product-search-target="noResults" style="display: none;">
                <div class="text-center text-muted py-5">
                    <i class="bi bi-emoji-frown" style="font-size: 3rem;"></i>
                    <p class="mt-3">{{ 'search.noResults'|trans }}</p>
                </div>
            </div>
        </div>
    </div>
    </div>
{% endblock %}
