{% extends 'adminBase.html.twig' %}

{% block title %}{{ 'admin.orders.detailsPageTitle'|trans }} {{ order.reference }} - Tiramisou
{% endblock %}

{% block body %}
	<div class="container my-4">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<h1>{{ 'admin.orders.detailsTitle'|trans }} {{ order.reference }}</h1>
			<a href="{{ path('admin.orders') }}" class="btn btn-secondary">{{ 'admin.common.backToList'|trans }}</a>
		</div>

		<div class="row">
			<div class="col-md-6 mb-4">
				<div class="card">
					<div class="card-header">
						<h5 class="mb-0">{{ 'admin.orders.details.generalInfo'|trans }}</h5>
					</div>
					<div class="card-body">
						<p>
							<strong>{{ 'admin.orders.details.reference'|trans }}</strong>
							{{ order.reference }}
						</p>
						<p>
							<strong>{{ 'admin.orders.details.status'|trans }}</strong>
							{% if order.status.value == 'in_preparation' %}
								<span class="badge bg-warning">{{ 'admin.common.status.inPreparation'|trans }}</span>
							{% elseif order.status.value == 'shipped' %}
								<span class="badge bg-info">{{ 'admin.common.status.shipped'|trans }}</span>
							{% elseif order.status.value == 'delivered' %}
								<span class="badge bg-success">{{ 'admin.common.status.delivered'|trans }}</span>
							{% elseif order.status.value == 'cancelled' %}
								<span class="badge bg-danger">{{ 'admin.common.status.cancelled'|trans }}</span>
							{% endif %}
						</p>
						<p>
							<strong>{{ 'admin.orders.details.itemCount'|trans }}</strong>
							<span class="badge bg-primary">{{ order.orderItem|length }}</span>
						</p>
						<p class="mb-0">
							<strong>{{ 'admin.orders.details.createdAt'|trans }}</strong>
							{{ order.createdAt|date('d/m/Y à H:i') }}
						</p>
					</div>
				</div>
			</div>

			<div class="col-md-6 mb-4">
				<div class="card">
					<div class="card-header">
						<h5 class="mb-0">{{ 'admin.orders.details.customerInfo'|trans }}</h5>
					</div>
					<div class="card-body">
						{% if order.customer %}
							<p>
								<strong>{{ 'admin.orders.details.customerName'|trans }}</strong>
								{{ order.customer.lastName }}
							</p>
							<p>
								<strong>{{ 'admin.orders.details.customerFirstName'|trans }}</strong>
								{{ order.customer.firstName }}
							</p>
							<p class="mb-0">
								<strong>{{ 'admin.orders.details.customerEmail'|trans }}</strong>
								<a href="mailto:{{ order.customer.email }}">{{ order.customer.email }}</a>
							</p>
						{% else %}
							<p class="text-muted mb-0">{{ 'admin.common.messages.noCustomer'|trans }}</p>
						{% endif %}
					</div>
				</div>
			</div>
		</div>

		<div class="row">
			<div class="col-md-12 mb-4">
				<div class="card">
					<div class="card-header">
						<h5 class="mb-0">{{ 'admin.orders.details.orderItems'|trans }}</h5>
					</div>
					<div class="card-body">
						{% if order.orderItem|length > 0 %}
							<table class="table table-striped">
								<thead>
									<tr>
										<th>{{ 'admin.orders.details.product'|trans }}</th>
										<th class="text-end">{{ 'admin.common.fields.unitPrice'|trans }}</th>
										<th class="text-center">{{ 'admin.common.fields.quantity'|trans }}</th>
										<th class="text-end">{{ 'admin.common.fields.subtotal'|trans }}</th>
									</tr>
								</thead>
								<tbody>
									{% set total = 0 %}
									{% for item in order.orderItem %}
										{% set subtotal = item.productPrice * item.quantity %}
										{% set total = total + subtotal %}
										<tr>
											<td>
												{% if item.product %}
													{{ item.product.name }}
												{% else %}
													<span class="text-muted">{{ 'admin.common.messages.deletedProduct'|trans }}</span>
												{% endif %}
											</td>
											<td class="text-end">{{ item.productPrice|number_format(2, ',', ' ') }} €</td>
											<td class="text-center">{{ item.quantity }}</td>
											<td class="text-end">{{ subtotal|number_format(2, ',', ' ') }} €</td>
										</tr>
									{% endfor %}
								</tbody>
								<tfoot>
									<tr class="fw-bold">
										<td colspan="3" class="text-end">{{ 'admin.common.fields.total'|trans }} :</td>
										<td class="text-end">{{ total|number_format(2, ',', ' ') }} €</td>
									</tr>
								</tfoot>
							</table>
						{% else %}
							<p class="text-muted mb-0">{{ 'admin.orders.details.noItems'|trans }}</p>
						{% endif %}
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
