{% extends 'adminBase.html.twig' %}

{% block title %}{{ 'admin.orders.pageTitle'|trans }}
{% endblock %}


{% block body %}
	<div class="m-4">
		<h1 class="">{{ 'admin.orders.title'|trans }}</h1>

		<table class="table table-hover mt-4">
			<thead>
				<tr>
					<th>{{ 'admin.orders.table.customer'|trans }}</th>
					<th>{{ 'admin.orders.table.reference'|trans }}</th>
					<th>{{ 'admin.orders.table.itemCount'|trans }}</th>
					<th>{{ 'admin.orders.table.status'|trans }}</th>
					<th>{{ 'admin.orders.table.date'|trans }}</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				{% for order in orders %}
					<tr>
						<td>{{ order.customer.lastName }}
							{{ order.customer.firstName }}</td>
						<td>{{ order.reference }}</td>
						<td>{{ order.orderItem|length }}</td>
						{% if order.status.value == "in_preparation" %}
							<td>
								<span class="badge bg-warning">{{ 'admin.common.status.inPreparation'|trans }}</span>
							</td>
						{% elseif order.status.value == "delivered" %}
							<td>
								<span class="badge bg-success">{{ 'admin.common.status.delivered'|trans }}</span>
							</td>
						{% elseif order.status.value == "cancelled" %}
							<td>
								<span class="badge bg-danger">{{ 'admin.common.status.cancelled'|trans }}</span>
							</td>
						{% elseif order.status.value ==  "shipped" %}
							<td>
								<span class="badge bg-info">{{ 'admin.common.status.shipped'|trans }}</span>
							</td>
						{% else %}
							<td>
								{{ order.status.value }}</td>
						{% endif %}
						<td>{{ order.createdAt|date('d/m/Y') }}</td>
						<td>
							<div class="dropdown">
								<button class="btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
									<i class="bi bi-three-dots"></i>
								</button>
								<ul class="dropdown-menu">
									<li>
										<a class="dropdown-item" href="{{ path('admin.order.show', {'id': order.id}) }}">{{ 'admin.common.actions.details'|trans }}</a>
									</li>
								</ul>
							</div>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
		<div class="d-flex flex-row justify-content-between align-items-center">
			<div>
				<b>{{ ordersCount }}</b>
				{{ 'admin.common.results'|trans }}
			</div>
			<div class="navigation">
				{{ knp_pagination_render(orders, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
			</div>
		</div>
	</div>
{% endblock %}
