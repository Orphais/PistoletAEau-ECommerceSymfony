{% extends 'adminBase.html.twig' %}

{% block title %}{{ 'admin.products.pageTitle'|trans }}
{% endblock %}


{% block body %}
	<div class="m-4">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<h1 class="">{{ 'admin.products.title'|trans }}</h1>
			<a href="{{ path('admin.product.new') }}" class="btn btn-secondary">{{ 'admin.products.addButton'|trans }}</a>
		</div>

		{% for message in app.flashes('success') %}
			<div class="alert alert-dismissible alert-success">
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
				{{ message }}
			</div>
		{% endfor %}

		<table class="table table-hover mt-4">
			<thead>
				<tr>
					<th></th>
					<th>{{ 'admin.products.table.name'|trans }}</th>
					<th>{{ 'admin.products.table.category'|trans }}</th>
					<th>{{ 'admin.products.table.description'|trans }}</th>
					<th>{{ 'admin.products.table.price'|trans }}</th>
					<th>{{ 'admin.products.table.stock'|trans }}</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				{% for product in products %}
					<tr>
						{% if product.image %}
							<td><img src="{{ product.image[0].url }}" alt="{{ product.name }}" width="50"></td>
						{% endif %}						
						<td>{{ product.name }}</td>
						<td>{{ product.category.name }}</td>
						<td>{{ product.description }}</td>
						<td>{{ product.price }}€</td>
						{% if product.stock != 0 %}
							<td>{{ product.stock }}</td>
						{% else %}
							<td class="text-primary">{{ 'admin.products.outOfStock'|trans }}</td>
						{% endif %}
						<td>
							<div class="dropdown">
								<button class="btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
									<i class="bi bi-three-dots"></i>
								</button>
								<ul class="dropdown-menu">
									<li>
										<a class="dropdown-item" href="{{ path('admin.product.show', {'id': product.id}) }}">{{ 'admin.common.actions.details'|trans }}</a>
									</li>
									<li>
										<a class="dropdown-item" href="{{ path('admin.product.edit', {'id': product.id}) }}">{{ 'admin.common.actions.edit'|trans }}</a>
									</li>
									<li>
										<button
											type="button"
											class="dropdown-item text-primary"
											data-delete-url="{{ path('admin.product.delete', {'id': product.id}) }}"
											data-delete-message="{{ 'admin.products.confirmDelete'|trans }} {{ product.name }} ?">
											{{ 'admin.common.actions.delete'|trans }}
										</button>
									</li>
								</ul>
							</div>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
		<div class="d-flex flex-row justify-content-between align-items-center">
			<div>
				<b>{{ productsCount }}</b>
				{{ 'admin.common.results'|trans }}
			</div>
			<div class="navigation">
				{{ knp_pagination_render(products, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
			</div>
		</div>
	</div>
{% endblock %}
