{% extends 'adminBase.html.twig' %}

{% block title %}{{ 'admin.products.detailsTitle'|trans }} {{ product.name }} - Tiramisou
{% endblock %}

{% block body %}
	<div class="container my-4">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<h1>{{ 'admin.products.detailsTitle'|trans }} {{ product.name }}</h1>
			<a href="{{ path('admin.products') }}" class="btn btn-secondary">{{ 'admin.common.backToList'|trans }}</a>
		</div>

		<div class="row">
			<div class="col-md-6 mb-4">
				<div class="card">
					<div class="card-header">
						<h5 class="mb-0">{{ 'admin.products.details.generalInfo'|trans }}</h5>
					</div>
					<div class="card-body">
						<p><strong>{{ 'admin.products.details.name'|trans }}</strong> {{ product.name }}</p>
						<p><strong>{{ 'admin.products.details.price'|trans }}</strong> {{ product.price }} €</p>
						<p><strong>{{ 'admin.products.details.stock'|trans }}</strong>
							{% if product.stock > 0 %}
								<span class="badge bg-success">{{ product.stock }} {{ 'admin.common.status.units'|trans }}</span>
							{% else %}
								<span class="badge bg-danger">{{ 'admin.common.status.outOfStock'|trans }}</span>
							{% endif %}
						</p>
						<p><strong>{{ 'admin.products.details.status'|trans }}</strong>
							{% if product.status.value == 'active' %}
								<span class="badge bg-success">{{ product.status.value }}</span>
							{% else %}
								<span class="badge bg-secondary">{{ product.status.value }}</span>
							{% endif %}
						</p>
						<p class="mb-0"><strong>{{ 'admin.products.details.createdAt'|trans }}</strong> {{ product.createdAt|date('d/m/Y à H:i') }}</p>
					</div>
				</div>
			</div>

			<div class="col-md-6 mb-4">
				<div class="card">
					<div class="card-header">
						<h5 class="mb-0">{{ 'admin.products.details.description'|trans }}</h5>
					</div>
					<div class="card-body">
						{% if product.description %}
							<p class="mb-0">{{ product.description }}</p>
						{% else %}
							<p class="text-muted mb-0">{{ 'admin.common.messages.noDescription'|trans }}</p>
						{% endif %}
					</div>
				</div>

				<div class="card mt-3">
					<div class="card-header">
						<h5 class="mb-0">{{ 'admin.products.details.category'|trans }}</h5>
					</div>
					<div class="card-body">
						{% if product.category %}
							<p class="mb-0">
								<span class="badge bg-primary">{{ product.category.name }}</span>
							</p>
						{% else %}
							<p class="text-muted mb-0">{{ 'admin.common.messages.noCategory'|trans }}</p>
						{% endif %}
					</div>
				</div>
			</div>
		</div>

		<div class="row">
			<div class="col-md-6 mb-4">
				<div class="card">
					<div class="card-header">
						<h5 class="mb-0">{{ 'admin.products.details.images'|trans }}</h5>
					</div>
					<div class="card-body">
						{% set images = product.image %}
						{% if images|length > 0 %}
							<div class="row">
								{% for image in images %}
									<div class="col-md-6 mb-3">
										<img src="{{ image.url }}" alt="{{ product.name }}" class="img-fluid rounded">
									</div>
								{% endfor %}
							</div>
						{% else %}
							<p class="text-muted mb-0">{{ 'admin.common.messages.noImage'|trans }}</p>
						{% endif %}
					</div>
				</div>
			</div>

			<div class="col-md-6 mb-4">
				<div class="card">
					<div class="card-header">
						<h5 class="mb-0">{{ 'admin.products.details.orderHistory'|trans }}</h5>
					</div>
					<div class="card-body">
						{% set orderItems = product.orderItems %}
						{% if orderItems|length > 0 %}
							<table class="table table-sm table-striped">
								<thead>
									<tr>
										<th>{{ 'admin.products.details.orderReference'|trans }}</th>
										<th class="text-center">{{ 'admin.common.fields.quantity'|trans }}</th>
										<th class="text-end">{{ 'admin.common.fields.price'|trans }}</th>
										<th class="text-center">{{ 'admin.common.fields.date'|trans }}</th>
									</tr>
								</thead>
								<tbody>
									{% for item in orderItems %}
										<tr>
											<td>{{ item.purchaseOrder.reference }}</td>
											<td class="text-center">{{ item.quantity }}</td>
											<td class="text-end">{{ item.productPrice|number_format(2, ',', ' ') }} €</td>
											<td class="text-center">{{ item.purchaseOrder.createdAt|date('d/m/Y') }}</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
							<p class="text-muted mb-0 mt-2">
								<small>{{ 'admin.products.details.totalOrders'|trans }} {{ orderItems|length }}</small>
							</p>
						{% else %}
							<p class="text-muted mb-0">{{ 'admin.products.details.neverOrdered'|trans }}</p>
						{% endif %}
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
