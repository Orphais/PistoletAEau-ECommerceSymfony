{% extends 'adminBase.html.twig' %}

{% block title %}
	{{ 'admin.users.pageTitle'|trans }}
{% endblock %}


{% block body %}
	<div class="m-4">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<h1 class="">{{ 'admin.users.title'|trans }}</h1>
			<a href="{{ path('admin.user.new') }}" class="btn btn-secondary">{{ 'admin.users.addButton'|trans }}</a>
		</div>

		{% for message in app.flashes('success') %}
			<div class="alert alert-dismissible alert-success">
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
				{{ message }}
			</div>
		{% endfor %}

		{% for message in app.flashes('error') %}
			<div class="alert alert-dismissible alert-danger">
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
				{{ message }}
			</div>
		{% endfor %}

		<table class="table table-hover mt-4">
			<thead>
				<tr>
					<th>{{ 'admin.users.table.firstName'|trans }}</th>
					<th>{{ 'admin.users.table.lastName'|trans }}</th>
					<th>{{ 'admin.users.table.email'|trans }}</th>
					<th>{{ 'admin.users.table.orderCount'|trans }}</th>
					<th>{{ 'admin.users.table.createdAt'|trans }}</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				{% for user in users %}
					<tr>
						<td>{{ user.firstName }}</td>
						<td>{{ user.lastName }}</td>
						<td>{{ user.email }}</td>
						<td>{{ user.orders|length }}</td>
						<td>{{ user.createdAt|date('d/m/Y') }}</td>
						<td>
							<div class="dropdown">
								<button class="btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
									<i class="bi bi-three-dots"></i>
								</button>
								<ul class="dropdown-menu">
									<li>
										<a class="dropdown-item" href="{{ path('admin.user.show', {'id': user.id}) }}">{{ 'admin.common.actions.details'|trans }}</a>
									</li>
									<li>
										<a class="dropdown-item" href="{{ path('admin.user.edit', {'id': user.id}) }}">{{ 'admin.common.actions.edit'|trans }}</a>
									</li>
									<li>
										<button type="button" class="dropdown-item text-primary" data-delete-url="{{ path('admin.user.delete', {'id': user.id}) }}" data-delete-message="{{ 'admin.users.confirmDelete'|trans }} {{ user.firstName }} {{ user.lastName }} ?">
											{{ 'admin.common.actions.delete'|trans }}
										</button>
									</li>
								</ul>
							</div>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
		<div class="d-flex flex-row justify-content-between align-items-center">
			<div>
				<b>{{ usersCount }}</b>
				{{ 'admin.common.results'|trans }}
			</div>
			<div class="navigation">
				{{ knp_pagination_render(users, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
			</div>
		</div>
	</div>
{% endblock %}
