{% extends 'adminBase.html.twig' %}

{% block title %}{{ 'admin.categories.detailsTitle'|trans }} {{ category.name }}
	- Tiramisou
{% endblock %}

{% block body %}
	<div class="container my-4">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<h1>{{ 'admin.categories.detailsTitle'|trans }} {{ category.name }}</h1>
			<a href="{{ path('admin.categories') }}" class="btn btn-secondary">{{ 'admin.common.backToList'|trans }}</a>
		</div>

		<div class="row">
			<div class="col-md-6 mb-4">
				<div class="card">
					<div class="card-header">
						<h5 class="mb-0">{{ 'admin.categories.details.generalInfo'|trans }}</h5>
					</div>
					<div class="card-body">
						<p>
							<strong>{{ 'admin.categories.details.name'|trans }}</strong>
							{{ category.name }}</p>
						<p>
							<strong>{{ 'admin.categories.details.productCount'|trans }}</strong>
							{{ category.products|length }}
						</p>
						<p class="mb-0">
							<strong>{{ 'admin.categories.details.createdAt'|trans }}</strong>
							{{ category.createdAt|date('d/m/Y à H:i') }}</p>
					</div>
				</div>
			</div>

			<div class="col-md-6 mb-4">
				<div class="card">
					<div class="card-header">
						<h5 class="mb-0">{{ 'admin.categories.details.description'|trans }}</h5>
					</div>
					<div class="card-body">
						{% if category.description %}
							<p class="mb-0">{{ category.description }}</p>
						{% else %}
							<p class="text-muted mb-0">{{ 'admin.common.messages.noDescription'|trans }}</p>
						{% endif %}
					</div>
				</div>
			</div>
		</div>

		<div class="row">
			<div class="col-md-12 mb-4">
				<div class="card">
					<div class="card-header">
						<h5 class="mb-0">{{ 'admin.categories.details.associatedProducts'|trans }}</h5>
					</div>
					<div class="card-body">
						{% if category.products|length > 0 %}
							<table class="table table-striped">
								<thead>
									<tr>
										<th>{{ 'admin.common.fields.name'|trans }}</th>
										<th class="text-end">{{ 'admin.common.fields.price'|trans }}</th>
										<th class="text-center">{{ 'admin.common.fields.stock'|trans }}</th>
										<th class="text-center">{{ 'admin.common.fields.status'|trans }}</th>
										<th class="text-center">{{ 'admin.common.actions.details'|trans }}</th>
									</tr>
								</thead>
								<tbody>
									{% for product in category.products %}
										<tr>
											<td>{{ product.name }}</td>
											<td class="text-end">{{ product.price|number_format(2, ',', ' ') }}
												€</td>
											<td class="text-center">
												{% if product.stock > 0 %}
													<span class="badge bg-success">{{ product.stock }}</span>
												{% else %}
													<span class="badge bg-danger">0</span>
												{% endif %}
											</td>
											<td class="text-center">
												{% if product.status.value == 'available' %}
													<span class="badge bg-success">{{ product.status.value }}</span>
												{% else %}
													<span class="badge bg-secondary">{{ product.status.value }}</span>
												{% endif %}
											</td>
											<td class="text-center">
												<a href="{{ path('admin.product.show', {id: product.id}) }}" class="btn btn-sm btn-info">{{ 'admin.common.actions.view'|trans }}</a>
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						{% else %}
							<p class="text-muted mb-0">{{ 'admin.categories.details.noProducts'|trans }}</p>
						{% endif %}
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
